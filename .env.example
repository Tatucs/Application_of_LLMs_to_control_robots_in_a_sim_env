# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Which provider the agent uses: gemini | anthropic
LLM_PROVIDER=

# Model id for the selected provider (leave blank to use the provider default)
LLM_MODEL=

# --- Google Gemini Developer API (free tier) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Anthropic ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Later: university OpenRouter ---
# OPENROUTER_API_KEY=

# --- Machine-specific paths (differ per teammate) ---
# Webots install root. Usually already set as a system variable by the installer.
WEBOTS_HOME=C:\Program Files\Webots
# The world the /sim workflow opens by default.
WEBOTS_WORLD=worlds/MCP-test.wbt
# Robot name as defined in the .wbt world; the MCP tools key off this.
ROBOT_NAME=NAO
